-- 5. STEAL LOGIC WITH RARITY MATCH
local function matchesFilter(egg)
    local rarity = getEggRarity(egg.Name)
    if stealFilterMode == 1 then
        return true -- All
    elseif stealFilterMode == 2 then
        return (rarity == "Legendary" or rarity == "Mythic" or rarity == "Divine" or rarity == "Ethereal")
    elseif stealFilterMode == 3 then
        return (rarity == "Divine" or rarity == "Ethereal")
    end
    return true
end

local function findHomeBase()
    for _, plot in ipairs(workspace:GetDescendants()) do
        if string.find(string.lower(plot.Name), "base") or string.find(string.lower(plot.Name), "plot") then
            if plot:FindFirstChild(player.Name) or plot:GetAttribute("Owner") == player.Name then
                return plot:IsA("BasePart") and plot.Position or (plot:FindFirstChildWhichIsA("BasePart") and plot:FindFirstChildWhichIsA("BasePart").Position)
            end
        end
    end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 5, 0)
end

local function runStealCycle(instant)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local homePos = findHomeBase()
    local eggs = getEggs()

    for _, egg in ipairs(eggs) do
        -- Stop immediately if toggled off
        if (not autoStealEnabled) and (not instantStealEnabled) then
            if currentTween then currentTween:Cancel() end
            break
        end

        if matchesFilter(egg) then
            local eggPart = egg:IsA("BasePart") and egg or egg:FindFirstChildWhichIsA("BasePart")
            if eggPart and eggPart.Parent then
                if instant then
                    root.CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)
                else
                    currentTween = TweenService:Create(root, TweenInfo.new(1.2, Enum.EasingStyle.Linear), {CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)})
                    currentTween:Play()
                    currentTween.Completed:Wait()
                end

                -- Prompt grab
                local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    else
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration + 0.1)
                        prompt:InputHoldEnd()
                    end
                end
                task.wait(0.3)

                -- Return to Base
                if instant then
                    root.CFrame = CFrame.new(homePos + Vector3.new(0, 4, 0))
                else
                    currentTween = TweenService:Create(root, TweenInfo.new(1.2, Enum.EasingStyle.Linear), {CFrame = CFrame.new(homePos + Vector3.new(0, 4, 0))})
                    currentTween:Play()
                    currentTween.Completed:Wait()
                end
                task.wait(0.8)
            end
        end
    end
end

-- Dedicated Steal Worker
task.spawn(function()
    while true do
        if instantStealEnabled then
            runStealCycle(true)
        elseif autoStealEnabled then
            runStealCycle(false)
        end
        task.wait(1)
    end
end)


makeToggle(cheatsScroll, "Auto Steal On Rare Spawn", false, function(on)
    autoStealOnSpawn = on
    if on then
        notify("Auto-Steal Active", "Watching for high-tier egg spawns!")
    end
end)

-- =======================================================
-- TAB 2: RARE RADAR (CLEAN ZERO-LAG 2D CARDS)
-- =======================================================
local function buildRadar()
    for _, child in ipairs(radarScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end

    local eggs = scanAllRares()

    if #eggs == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(0.96, 0, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Text = "Scanning... Waiting for rare eggs to spawn."
        empty.TextColor3 = Color3.fromRGB(180, 180, 180)
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 11
        empty.Parent = radarScroll
        return
    end

    radarScroll.CanvasSize = UDim2.new(0, 0, 0, 10 + (#eggs * 58))

    for _, data in ipairs(eggs) do
        local card = Instance.new("Frame")
        card.Size = UDim2.new(0.96, 0, 0, 52)
        card.BackgroundColor3 = Color3.fromRGB(26, 28, 38)
        card.Parent = radarScroll
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

        local stroke = Instance.new("UIStroke", card)
        stroke.Color = data.Color
        stroke.Thickness = 1.4

        -- Fast 2D Circular Badge with Initial Letter
        local badge = Instance.new("TextLabel")
        badge.Size = UDim2.new(0, 36, 0, 36)
        badge.Position = UDim2.new(0, 6, 0.5, -18)
        badge.BackgroundColor3 = Color3.fromRGB(18, 19, 26)
        badge.Text = string.sub(data.Name, 1, 1)
        badge.TextColor3 = data.Color
        badge.Font = Enum.Font.FredokaOne
        badge.TextSize = 18
        badge.Parent = card
        Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)
        
        local bStroke = Instance.new("UIStroke", badge)
        bStroke.Color = data.Color
        bStroke.Thickness = 1.2

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.54, 0, 1, 0)
        lbl.Position = UDim2.new(0, 48, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = string.format("%s\n%s | %dm\n%s", data.Name, data.Tier, data.Distance, data.Weight)
        lbl.TextColor3 = data.Color
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 10
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = card

        local tpBtn = Instance.new("TextButton")
        tpBtn.Size = UDim2.new(0.24, 0, 0, 30)
        tpBtn.Position = UDim2.new(0.74, 0, 0.2, 0)
        tpBtn.BackgroundColor3 = Color3.fromRGB(70, 75, 110)
        tpBtn.Text = "TP"
        tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tpBtn.Font = Enum.Font.GothamBold
        tpBtn.TextSize = 12
        tpBtn.Parent = card
        Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 6)

        tpBtn.MouseButton1Click:Connect(function()
            if character and character:FindFirstChild("HumanoidRootPart") and data.Part and data.Part.Parent then
                stabilize()
                character.HumanoidRootPart.CFrame = data.Part.CFrame * CFrame.new(0, 4, 0)
                stabilize()
                notify("Teleported", "Arrived at " .. data.Name)
            end
        end)
    end
end

-- Refresh radar on a safe 4-second interval when visible
task.spawn(function()
    while true do
        if radarScroll.Visible then
            buildRadar()
        end
        task.wait(4)
    end
end)

-- Defer initial scan to prevent execution freeze
task.defer(buildRadar)

local function renderCard3D(parentFrame, eggObj, part)
    pcall(function()
        local vp = Instance.new("ViewportFrame")
        vp.Size = UDim2.new(0, 48, 0, 48)
        vp.Position = UDim2.new(0, 5, 0.5, -24)
        vp.BackgroundTransparency = 1
        vp.LightColor = Color3.fromRGB(255, 255, 255)
        vp.Ambient = Color3.fromRGB(220, 220, 220)
        vp.Parent = parentFrame

        eggObj.Archivable = true
        part.Archivable = true

        local clone = eggObj:Clone()
        if not clone then
            clone = Instance.new("Model")
            part:Clone().Parent = clone
        end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("BillboardGui") or d:IsA("ProximityPrompt") then
                d:Destroy()
            end
        end

        clone.Parent = vp
        local cf, size
        if clone:IsA("Model") then
            cf, size = clone:GetBoundingBox()
        else
            cf = clone.CFrame
            size = clone.Size
        end

        local cam = Instance.new("Camera")
        cam.Parent = vp
        vp.CurrentCamera = cam
        local maxDim = math.max(size.X, size.Y, size.Z)
        local dist = maxDim > 1 and maxDim * 1.8 or 3.5
        cam.CFrame = CFrame.new(cf.Position + Vector3.new(0, size.Y * 0.2, dist), cf.Position)
    end)
end


-- UNOWNED ESP SYSTEM
-- =======================================================

local function clearESP()
    for _, tag in ipairs(espStorage) do
        if tag and tag.Parent then tag:Destroy() end
    end
    espStorage = {}
end

local function refreshESP()
    clearESP()
    if not espEnabled then return end

    local unownedEggs = scanUnownedEggs()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, eggData in ipairs(unownedEggs) do
        local targetPart = eggData.Part
        if targetPart and not targetPart:FindFirstChild("UnownedEggESP") then
            local rarity, rarityColor = getEggInfo(eggData.Name)

            local bill = Instance.new("BillboardGui")
            bill.Name = "UnownedEggESP"
            bill.Size = UDim2.new(0, 185, 0, 60)
            bill.AlwaysOnTop = true
            bill.Adornee = targetPart

            local box = Instance.new("Frame")
            box.Size = UDim2.new(1, 0, 1, 0)
            box.BackgroundColor3 = Color3.fromRGB(18, 19, 26)
            box.BackgroundTransparency = 0.2
            box.Parent = bill
            Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

            local stroke = Instance.new("UIStroke", box)
            stroke.Color = rarityColor
            stroke.Thickness = 1.5

            pcall(function()
                render3DEgg(box, eggData.Object, targetPart)
            end)

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, -58, 1, 0)
            txt.Position = UDim2.new(0, 56, 0, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = rarityColor
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 10
            txt.TextXAlignment = Enum.TextXAlignment.Left
            txt.Parent = box

            bill.Parent = targetPart
            table.insert(espStorage, bill)

            task.spawn(function()
                while espEnabled and targetPart and targetPart.Parent do
                    if isInsideMyRanch(targetPart.Position) then
                        bill:Destroy()
                        break
                    end
                    if root then
                        local studs = math.floor((root.Position - targetPart.Position).Magnitude)
                        local meters = math.floor(studs * 0.28)
                        txt.Text = string.format("[NOT OWNED]\n%s\n%s | %dm\n%s", eggData.Name, rarity, meters, eggData.Weight)
                    end
                    task.wait(0.5)
                end
                if bill then bill:Destroy() end
            end)
        end
    end
end

-- =======================================================
-- FAST 1-SECOND STEAL TO BASE
-- =======================================================

local function executeStealCycle(instant)
    if isStealingBusy then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targets = scanUnownedEggs()
    if #targets == 0 then return end

    isStealingBusy = true
    local homePos = getMyRanchPosition()

    for _, eggData in ipairs(targets) do
        if not (autoStealEnabled or instantStealEnabled) then break end
        local eggPart = eggData.Part

        if eggPart and eggPart.Parent and not isInsideMyRanch(eggPart.Position) then
            stabilizeCharacter()

            -- 1. Travel to egg
            if instant then
                root.CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)
            else
                local tween = TweenService:Create(root, TweenInfo.new(0.7, Enum.EasingStyle.Linear), {CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)})
                tween:Play()
                tween.Completed:Wait()
            end
            stabilizeCharacter()
            task.wait(0.1)

            -- 2. Fast 1s Proximity Interaction
            local prompt = eggData.Object:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                if fireproximityprompt then
                    fireproximityprompt(prompt, 0)
                end
                prompt:InputHoldBegin()
                task.wait(0.2)
                prompt:InputHoldEnd()
            end

            -- Also fire touch interest if the game uses physics touches
            if firetouchinterest and eggPart then
                pcall(function()
                    firetouchinterest(root, eggPart, 0)
                    task.wait(0.05)
                    firetouchinterest(root, eggPart, 1)
                end)
            end
            task.wait(0.6)

            -- 3. Snap back to Ranch Nest
            stabilizeCharacter()
            root.CFrame = CFrame.new(homePos + Vector3.new(0, 4, 0))
            stabilizeCharacter()
            task.wait(0.5)
        end
    end

    stabilizeCharacter()
    isStealingBusy = false
end

task.spawn(function()
    while true do
        if instantStealEnabled then
            executeStealCycle(true)
        elseif autoStealEnabled then
            executeStealCycle(false)
        end
        task.wait(0.4)
    end
end)


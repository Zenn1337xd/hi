            box.BackgroundColor3 = Color3.fromRGB(15, 17, 24)
            box.BackgroundTransparency = 0.2
            box.Parent = bill
            Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

            local stroke = Instance.new("UIStroke", box)
            stroke.Color = data.Color
            stroke.Thickness = 1.6

            local img = Instance.new("ImageLabel")
            img.Size = UDim2.new(0, 36, 0, 36)
            img.Position = UDim2.new(0, 6, 0.5, -18)
            img.BackgroundTransparency = 1
            img.Image = data.Image
            img.ImageColor3 = data.Color
            img.Parent = box
            Instance.new("UICorner", img).CornerRadius = UDim.new(0, 6)

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, -48, 1, 0)
            txt.Position = UDim2.new(0, 46, 0, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = data.Color

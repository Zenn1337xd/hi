-- Fast 1-Second Steal Action
local function stealEgg(targetData)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not targetData.Part or not targetData.Part.Parent then return end

    local homePos = getMyRanchPosition()
    stabilize()

    -- 1. Instant Teleport to Rare Egg
    root.CFrame = targetData.Part.CFrame * CFrame.new(0, 3, 0)
    stabilize()
    task.wait(0.1)

    -- 2. Fast Grab Interaction
    local prompt = targetData.Object:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then fireproximityprompt(prompt, 0) end
        prompt:InputHoldBegin()
        task.wait(0.2)
        prompt:InputHoldEnd()
    end
    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, targetData.Part, 0)
            task.wait(0.05)
            firetouchinterest(root, targetData.Part, 1)
        end)
    end
    task.wait(0.5)

    -- 3. Return to Ranch Nest
    stabilize()
    root.CFrame = CFrame.new(homePos + Vector3.new(0, 5, 0))
    stabilize()
    notify("Steal Success!", "Delivered " .. targetData.Name .. " to Ranch!")
end

-- Auto-Steal on Spawn Watcher
task.spawn(function()
    while true do
        if autoStealOnSpawn and not isStealing then
            local eggs = scanRareMapEggs()
            for _, egg in ipairs(eggs) do
                if egg.Rank >= 3 and not isInsideMyRanch(egg.Part.Position) then
                    isStealing = true
                    stealEgg(egg)
                    task.wait(1)
                    isStealing = false
                    break
                end
            end
        end
        task.wait(0.5)
    end
end)

-- Continuous Speed Boost
local speedConn
local function updateSpeed()
    if speedConn then speedConn:Disconnect() speedConn = nil end
    if speedEnabled then
        speedConn = RunService.Heartbeat:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                local hum = character:FindFirstChildWhichIsA("Humanoid")
                hum.WalkSpeed = currentSpeedValue
                if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
                    hum.SeatPart.MaxSpeed = currentSpeedValue
                    hum.SeatPart.ThrottleFloat = 1
                end
            end
        end)
    else
        if character and character:FindFirstChildWhichIsA("Humanoid") then
            character:FindFirstChildWhichIsA("Humanoid").WalkSpeed = 16
        end
    end
end


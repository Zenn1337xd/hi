-- ESP System
local function clearESP()
    for _, tag in ipairs(espStorage) do
        if tag and tag.Parent then tag:Destroy() end
    end
    espStorage = {}
end

local function refreshESP()
    clearESP()
    if not espEnabled then return end

    local unowned = scanEggs(true)
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, data in ipairs(unowned) do
        local targetPart = data.Part
        if targetPart and not targetPart:FindFirstChild("UnownedEggESP") then
            local rarity, rarityColor = getEggInfo(data.Name)

            local bill = Instance.new("BillboardGui")
            bill.Name = "UnownedEggESP"
            bill.Size = UDim2.new(0, 185, 0, 58)
            bill.AlwaysOnTop = true
            bill.Adornee = targetPart

            local box = Instance.new("Frame")
            box.Size = UDim2.new(1, 0, 1, 0)
            box.BackgroundColor3 = Color3.fromRGB(18, 19, 26)
            box.BackgroundTransparency = 0.25
            box.Parent = bill
            Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

            local stroke = Instance.new("UIStroke", box)
            stroke.Color = rarityColor
            stroke.Thickness = 1.5

            render3D(box, data.Object, targetPart)

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, -58, 1, 0)
            txt.Position = UDim2.new(0, 56, 0, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = rarityColor
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 10
            txt.TextXAlignment = Enum.TextXAlignment.Left
            txt.Parent = box

            bill.Parent = targetPart
            table.insert(espStorage, bill)

            task.spawn(function()
                while espEnabled and targetPart and targetPart.Parent do
                    if isInsideMyRanch(targetPart.Position) then
                        bill:Destroy()
                        break
                    end
                    if root then
                        local dist = math.floor((root.Position - targetPart.Position).Magnitude * 0.28)
                        txt.Text = string.format("[NOT OWNED]\n%s\n%s | %dm\n%s", data.Name, rarity, dist, data.Weight)
                    end
                    task.wait(0.5)
                end
                if bill then bill:Destroy() end
            end)
        end
    end
end


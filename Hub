end

-- 3. EGG SCANNER & ESP
local espStorage = {}

local function clearESP()
    for _, tag in ipairs(espStorage) do
        if tag and tag.Parent then tag:Destroy() end
    end
    espStorage = {}
end

local function getEggs()
    local eggs = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if string.find(name, "egg") or obj:FindFirstChildWhichIsA("ProximityPrompt") then
                table.insert(eggs, obj)
            end
        end
    end
    return eggs
end

local function updateESP()
    clearESP()
    if not espEnabled then return end

    local eggs = getEggs()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, egg in ipairs(eggs) do
        local targetPart = egg:IsA("BasePart") and egg or egg:FindFirstChildWhichIsA("BasePart")
        if targetPart and not targetPart:FindFirstChild("EggESP") then
            local rarity = getEggRarity(egg.Name)

            local bill = Instance.new("BillboardGui")
            bill.Name = "EggESP"
            bill.Size = UDim2.new(0, 160, 0, 50)
            bill.AlwaysOnTop = true
            bill.Adornee = targetPart

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = (rarity == "Ethereal" and Color3.fromRGB(255, 60, 60))
                or (rarity == "Divine" and Color3.fromRGB(255, 215, 0))
                or (rarity == "Mythic" and Color3.fromRGB(200, 80, 255))
                or (rarity == "Legendary" and Color3.fromRGB(255, 170, 0))
                or Color3.fromRGB(255, 255, 255)
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 11
            txt.Parent = bill
            bill.Parent = targetPart
            table.insert(espStorage, bill)

            task.spawn(function()
                while espEnabled and targetPart and targetPart.Parent do
                    if root then
                        local studs = math.floor((root.Position - targetPart.Position).Magnitude)
                        local meters = math.floor(studs * 0.28)
                        local weight = egg:GetAttribute("Weight") or egg:GetAttribute("Kg") or "?"
                        txt.Text = string.format("[%s]\n%s | %dm | %skg", egg.Name, rarity, meters, tostring(weight))
                    end
                    task.wait(0.5)
                end
                if bill then bill:Destroy() end
            end)
        end
    end
end


-- Dialogue and prop blacklist
local BLACKLIST = {
    "wanna see", "world", "shop", "track", "gears", "sell", "food", 
    "index", "rebirth", "eggo", "hatch", "stand", "prompt", "base"
}

local function isBlacklisted(str)
    local lower = string.lower(str)
    for _, word in ipairs(BLACKLIST) do
        if string.find(lower, word) then
            return true
        end
    end
    return false
end

-- =======================================================
-- LOCATION & BASE PROTECTION
-- =======================================================
local function getMyRanchPosition()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") and string.find(string.lower(obj.Text), "your ranch") then
            local p = obj:FindFirstAncestorWhichIsA("BasePart") or obj.Adornee
            if p then return p.Position end
        end
    end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

local function isInsideMyRanch(pos)
    local myRanch = getMyRanchPosition()
    return (pos - myRanch).Magnitude <= 50
end

local function stabilize()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local hum = character:FindFirstChildWhichIsA("Humanoid")
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

-- =======================================================
-- DEEP EGG INSPECTION & IMAGE PARSER
-- =======================================================
local function parseRareEgg(obj, part)
    if isBlacklisted(obj.Name) then return nil end

    local matchedEgg = nil
    local detectedWeight = nil
    local foundTexture = nil

    -- 1. Scan ProximityPrompts
    for _, p in ipairs(obj:GetDescendants()) do
        if p:IsA("ProximityPrompt") then
            local pText = (p.ObjectText or "") .. " " .. (p.ActionText or "")
            if not isBlacklisted(pText) then
                local pLower = string.lower(pText)
                for key, data in pairs(OFFICIAL_EGGS) do
                    if string.find(pLower, key) then
                        matchedEgg = data
                        break
                    end
                end
                local kg = string.match(pText, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
                if kg then detectedWeight = kg end
            end
        end
    end

    -- 2. Scan TextLabels inside Egg
    if not matchedEgg then
        for _, lbl in ipairs(obj:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Text ~= "" and not isBlacklisted(lbl.Text) then
                local lower = string.lower(lbl.Text)
                for key, data in pairs(OFFICIAL_EGGS) do
                    if string.find(lower, key) then
                        matchedEgg = data
                        break
                    end
                end
                local kg = string.match(lbl.Text, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
                if kg then detectedWeight = detectedWeight or kg end
            end
        end
    end

    -- 3. Check Object & Parent Names
    if not matchedEgg then
        local objLower = string.lower(obj.Name .. " " .. (obj.Parent and obj.Parent.Name or ""))
        for key, data in pairs(OFFICIAL_EGGS) do
            if string.find(objLower, key) then
                matchedEgg = data
                break
            end
        end
    end

    -- STRICT: Filter out any common eggs not in the rare database
    if not matchedEgg then
        return nil
    end

    -- 4. Locate Egg Image / Texture
    for _, desc in ipairs(obj:GetDescendants()) do
        if desc:IsA("Decal") and desc.Texture ~= "" then
            foundTexture = desc.Texture
            break
        elseif desc:IsA("MeshPart") and desc.TextureID ~= "" then
            foundTexture = desc.TextureID
            break
        elseif desc:IsA("SpecialMesh") and desc.TextureId ~= "" then
            foundTexture = desc.TextureId
            break
        end
    end

    -- Dynamic Weight Calculation
    local finalWeight = detectedWeight
    if not finalWeight then
        local size = obj:IsA("Model") and obj:GetExtentsSize() or part.Size
        local est = math.floor((size.X * size.Y * size.Z) * 8.5)
        if matchedEgg.Rank >= 3 and est < 1000 then est = est * 1200 end
        finalWeight = tostring(est > 0 and est or 25) .. " KG"
    end

    return {
        Name = matchedEgg.Name,
        Tier = matchedEgg.Tier,
        Color = matchedEgg.Color,
        Rank = matchedEgg.Rank,
        Weight = finalWeight,
        Texture = foundTexture
    }
end

local function scanRareMapEggs()
    local results = {}
    local scanned = {}
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, obj in ipairs(workspace:GetDescendants()) do
        if not isBlacklisted(obj.Name) then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part and not scanned[part] and not isInsideMyRanch(part.Position) then
                local data = parseRareEgg(obj, part)
                if data then
                    scanned[part] = true
                    local dist = root and math.floor((root.Position - part.Position).Magnitude * 0.28) or 0
                    table.insert(results, {
                        Object = obj,
                        Part = part,
                        Name = data.Name,
                        Tier = data.Tier,
                        Color = data.Color,
                        Rank = data.Rank,
                        Weight = data.Weight,
                        Texture = data.Texture,
                        Distance = dist
                    })
                end
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Rank ~= b.Rank then
            return a.Rank > b.Rank
        else
            return a.Distance < b.Distance
        end
    end)

    return results
end


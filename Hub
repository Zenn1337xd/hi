-- Fast 1s Steal Routine (Strictly targets wild unowned eggs)
local function doSteal(instant)
    if isStealing then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targets = scanSpawnedEggsOnly()
    if #targets == 0 then return end

    isStealing = true
    local home = getMyRanchPosition()

    for _, data in ipairs(targets) do
        if not (autoStealEnabled or instantStealEnabled) then break end
        local eggPart = data.Part

        if eggPart and eggPart.Parent and not isInsideMyRanch(eggPart.Position) then
            stabilize()

            -- Move to egg
            if instant then
                root.CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)
            else
                local tw = TweenService:Create(root, TweenInfo.new(0.6, Enum.EasingStyle.Linear), {CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)})
                tw:Play()
                tw.Completed:Wait()
            end
            stabilize()
            task.wait(0.1)

            -- Quick grab
            local prompt = data.Object:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                if fireproximityprompt then fireproximityprompt(prompt, 0) end
                prompt:InputHoldBegin()
                task.wait(0.2)
                prompt:InputHoldEnd()
            end
            if firetouchinterest then
                pcall(function()
                    firetouchinterest(root, eggPart, 0)
                    task.wait(0.05)
                    firetouchinterest(root, eggPart, 1)
                end)
            end
            task.wait(0.6)

            -- Snap to Ranch
            stabilize()
            root.CFrame = CFrame.new(home + Vector3.new(0, 4, 0))
            stabilize()
            task.wait(0.5)
        end
    end

    stabilize()
    isStealing = false
end

task.spawn(function()
    while true do
        if instantStealEnabled then
            doSteal(true)
        elseif autoStealEnabled then
            doSteal(false)
        end
        task.wait(0.5)
    end
end)


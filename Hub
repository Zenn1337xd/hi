-- RARITY DATABASE & SETTINGS
-- =======================================================
local EGG_RARITIES = {
    ["Cherub"] = "Ethereal",
    ["Black Hole"] = "Ethereal",
    ["Solaris"] = "Ethereal",
    ["Void"] = "Ethereal",
    ["Phoenix"] = "Divine",
    ["Angelic"] = "Divine",
    ["Volcanic"] = "Divine",
    ["Galaxy"] = "Mythic",
    ["Dragon"] = "Mythic",
    ["Golden"] = "Legendary",
    ["Crystal"] = "Legendary",
    ["Magma"] = "Epic",
    ["Forest"] = "Rare",
    ["Desert"] = "Uncommon",
    ["White"] = "Common"
}

local function getEggRarity(name)
    for eggName, rarity in pairs(EGG_RARITIES) do
        if string.find(string.lower(name), string.lower(eggName)) then
            return rarity
        end
    end
    -- Fallback checks based on keywords in name
    local lower = string.lower(name)
    if string.find(lower, "ethereal") or string.find(lower, "eternal") then return "Ethereal" end
    if string.find(lower, "divine") then return "Divine" end
    if string.find(lower, "mythic") then return "Mythic" end
    if string.find(lower, "legendary") then return "Legendary" end
    return "Normal"
end


local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local targetParent = nil

-- Determine appropriate UI container (CoreGui fallback to PlayerGui)
local hasCoreGui, _ = pcall(function()
    targetParent = CoreGui
end)
if not hasCoreGui or not targetParent then
    targetParent = player:WaitForChild("PlayerGui")
end

-- Destroy previous session to prevent duplicates
if targetParent:FindFirstChild("RidePetHub") then
    targetParent.RidePetHub:Destroy()
end

-- Notification on launch
pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "Ride a Pet Hub",
        Text = "Owned by kevan#9999",
        Duration = 4
    })
end)

-- Root ScreenGui

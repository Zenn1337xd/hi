-- Fast 1-Second Steal (Prioritizes Rarest First)
local function doSteal(instant)
    if isStealing then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targets = scanRealSpawnedEggs()
    if #targets == 0 then return end

    isStealing = true
    local home = getMyRanchPosition()

    for _, data in ipairs(targets) do
        if not (autoStealEnabled or instantStealEnabled) then break end
        local eggPart = data.Part

        if eggPart and eggPart.Parent and not isInsideAnyRanch(eggPart.Position) then
            stabilize()

            if instant then
                root.CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)
            else
                local tw = TweenService:Create(root, TweenInfo.new(0.6, Enum.EasingStyle.Linear), {CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)})
                tw:Play()
                tw.Completed:Wait()
            end
            stabilize()
            task.wait(0.1)

            local prompt = data.Object:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                if fireproximityprompt then fireproximityprompt(prompt, 0) end
                prompt:InputHoldBegin()
                task.wait(0.2)
                prompt:InputHoldEnd()
            end
            if firetouchinterest then
                pcall(function()
                    firetouchinterest(root, eggPart, 0)
                    task.wait(0.05)
                    firetouchinterest(root, eggPart, 1)
                end)
            end
            task.wait(0.6)

            stabilize()
            root.CFrame = CFrame.new(home + Vector3.new(0, 4, 0))
            stabilize()
            task.wait(0.5)
        end
    end

    stabilize()
    isStealing = false
end

task.spawn(function()
    while true do
        if instantStealEnabled then
            doSteal(true)
        elseif autoStealEnabled then
            doSteal(false)
        end
        task.wait(0.5)
    end
end)

-- Continuous Speed Boost Loop
local speedConn
local function updateSpeed()
    if speedConn then speedConn:Disconnect() speedConn = nil end
    if speedEnabled then
        speedConn = RunService.Heartbeat:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                local hum = character:FindFirstChildWhichIsA("Humanoid")
                hum.WalkSpeed = currentSpeedValue
                if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
                    hum.SeatPart.MaxSpeed = currentSpeedValue
                    hum.SeatPart.ThrottleFloat = 1
                end
            end
        end)
    else
        if character and character:FindFirstChildWhichIsA("Humanoid") then
            character:FindFirstChildWhichIsA("Humanoid").WalkSpeed = 16
        end
    end
end


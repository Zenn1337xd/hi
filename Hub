-- Helper: Locate Eggs in Workspace
local function getEggs()
    local eggs = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if string.find(name, "egg") or obj:FindFirstChildWhichIsA("ProximityPrompt") then
                table.insert(eggs, obj)
            end
        end
    end
    return eggs
end

-- 3. ESP FOR EGGS (Name, Distance in meters, Attributes/Kg)
local espStorage = {}

local function clearESP()
    for _, v in pairs(espStorage) do
        if v then v:Destroy() end
    end
    espStorage = {}
end

local function updateESP()
    if not espEnabled then
        clearESP()
        return
    end

    local eggs = getEggs()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, egg in ipairs(eggs) do
        local targetPart = egg:IsA("BasePart") and egg or egg:FindFirstChildWhichIsA("BasePart")
        if targetPart and not targetPart:FindFirstChild("EggTag") then
            -- Billboard Label
            local bill = Instance.new("BillboardGui")
            bill.Name = "EggTag"
            bill.Size = UDim2.new(0, 150, 0, 45)
            bill.AlwaysOnTop = true
            bill.Adornee = targetPart

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = Color3.fromRGB(255, 230, 0)
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 11
            txt.Parent = bill

            bill.Parent = targetPart
            table.insert(espStorage, bill)

            -- Live distance & stat calculation
            task.spawn(function()
                while espEnabled and targetPart and targetPart.Parent do
                    if root then
                        local studs = math.floor((root.Position - targetPart.Position).Magnitude)
                        local meters = math.floor(studs * 0.28) -- 1 stud ≈ 0.28 meters
                        local kgText = targetPart.Parent:GetAttribute("Weight") or targetPart.Parent:GetAttribute("Kg") or "N/A"
                        txt.Text = string.format("[%s]\n%dm | %s kg", egg.Name, meters, tostring(kgText))
                    end
                    task.wait(0.5)
                end
                if bill then bill:Destroy() end
            end)
        end
    end
end


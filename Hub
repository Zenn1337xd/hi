-- Locate your ranch
local function getMyRanchPosition()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BillboardGui") or v:IsA("TextLabel") then
            if string.find(string.lower(tostring(v.Text or "")), "your ranch") then
                local part = v:FindFirstAncestorWhichIsA("BasePart") or v.Adornee
                if part then return part.Position end
            end
        end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if string.find(string.lower(v.Name), string.lower(player.Name)) and string.find(string.lower(v.Name), "ranch") then
            local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart")
            if part then return part.Position end
        end
    end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

-- Find all actual active eggs
local function scanEggs()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and string.find(string.lower(obj.Name), "egg") then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part and not string.find(string.lower(obj.Name), "stand") and not string.find(string.lower(obj.Name), "hatch") then
                table.insert(list, {
                    Object = obj,
                    Part = part,
                    Name = obj.Name
                })
            end
        end
    end
    return list
end

-- Stop physics flinging
local function stabilizeCharacter()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- Fixed Steal Routine
local function doSteal(instant)
    if isStealingBusy then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local eggs = scanEggs()
    if #eggs == 0 then return end

    isStealingBusy = true
    local homePos = getMyRanchPosition()

    for _, eggData in ipairs(eggs) do
        if not (autoStealEnabled or instantStealEnabled) then break end
        local eggPart = eggData.Part

        if eggPart and eggPart.Parent then
            stabilizeCharacter()

            -- Move to Egg
            if instant then
                root.CFrame = eggPart.CFrame * CFrame.new(0, 3.5, 0)
            else
                local tween = TweenService:Create(root, TweenInfo.new(1, Enum.EasingStyle.Linear), {CFrame = eggPart.CFrame * CFrame.new(0, 3.5, 0)})
                tween:Play()
                tween.Completed:Wait()
            end
            task.wait(0.2)

            -- Interact / Steal
            local prompt = eggData.Object:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                if fireproximityprompt then
                    fireproximityprompt(prompt, 0)
                else
                    prompt:InputHoldBegin()
                    task.wait(prompt.HoldDuration + 0.1)
                    prompt:InputHoldEnd()
                end
            end
            task.wait(0.4)

            -- Deliver back to Ranch
            stabilizeCharacter()
            if instant then
                root.CFrame = CFrame.new(homePos + Vector3.new(0, 5, 0))
            else
                local returnTween = TweenService:Create(root, TweenInfo.new(1, Enum.EasingStyle.Linear), {CFrame = CFrame.new(homePos + Vector3.new(0, 5, 0))})
                returnTween:Play()
                returnTween.Completed:Wait()
            end
            task.wait(0.6)
        end
    end

    stabilizeCharacter()
    isStealingBusy = false
end

-- Steal Worker Loop
task.spawn(function()
    while true do
        if instantStealEnabled then
            doSteal(true)
        elseif autoStealEnabled then
            doSteal(false)
        end
        task.wait(0.5)
    end
end)

-- Speed Boost Worker
local function setSpeed(enabled)
    speedEnabled = enabled
    if speedConnection then speedConnection:Disconnect() speedConnection = nil end
    if enabled then
        speedConnection = RunService.Heartbeat:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                local hum = character:FindFirstChildWhichIsA("Humanoid")
                hum.WalkSpeed = 1000
                if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
                    hum.SeatPart.MaxSpeed = 1000
                    hum.SeatPart.ThrottleFloat = 1
                end
            end
        end)
    else
        if character and character:FindFirstChildWhichIsA("Humanoid") then
            character:FindFirstChildWhichIsA("Humanoid").WalkSpeed = 16
        end
    end
end

-- Infinite Jump Worker
local function setInfJump(enabled)
    infJumpEnabled = enabled
    if jumpConnection then jumpConnection:Disconnect() jumpConnection = nil end
    if enabled then
        jumpConnection = UserInputService.JumpRequest:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                character:FindFirstChildWhichIsA("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end


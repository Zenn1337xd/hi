-- 5. AUTO & INSTANT STEAL
local function findHomeBase()
    -- Look for plot or base matching player name
    for _, plot in ipairs(workspace:GetDescendants()) do
        if string.find(string.lower(plot.Name), "base") or string.find(string.lower(plot.Name), "plot") then
            if plot:FindFirstChild(player.Name) or plot:GetAttribute("Owner") == player.Name then
                return plot:IsA("BasePart") and plot.Position or (plot:FindFirstChildWhichIsA("BasePart") and plot:FindFirstChildWhichIsA("BasePart").Position)
            end
        end
    end
    -- Fallback to spawn point
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 5, 0)
end

local function executeSteal(instant)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local homePos = findHomeBase()
    local eggs = getEggs()

    for _, egg in ipairs(eggs) do
        if not (autoStealEnabled or instantStealEnabled) then break end
        local eggPart = egg:IsA("BasePart") and egg or egg:FindFirstChildWhichIsA("BasePart")
        
        if eggPart then
            -- Move to egg
            if instant then
                root.CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)
            else
                local tween = TweenService:Create(root, TweenInfo.new(1.5, Enum.EasingStyle.Linear), {CFrame = eggPart.CFrame * CFrame.new(0, 3, 0)})
                tween:Play()
                tween.Completed:Wait()
            end

            -- Trigger interaction prompt if present
            local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                if fireproximityprompt then
                    fireproximityprompt(prompt)
                else
                    prompt:InputHoldBegin()
                    task.wait(prompt.HoldDuration + 0.1)
                    prompt:InputHoldEnd()
                end
            end
            task.wait(0.3)

            -- Return to base with egg
            if instant then
                root.CFrame = CFrame.new(homePos + Vector3.new(0, 4, 0))
            else
                local returnTween = TweenService:Create(root, TweenInfo.new(1.5, Enum.EasingStyle.Linear), {CFrame = CFrame.new(homePos + Vector3.new(0, 4, 0))})
                returnTween:Play()
                returnTween.Completed:Wait()
            end
            task.wait(1)
        end
    end
end

task.spawn(function()
    while true do
        if instantStealEnabled then
            executeSteal(true)
        elseif autoStealEnabled then
            executeSteal(false)
        end
        task.wait(1)
    end
end)


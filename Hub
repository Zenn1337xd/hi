local EGG_RARITIES = {
    ["Solaris"] = {Rarity = "Ethereal", Color = Color3.fromRGB(255, 65, 65)},
    ["Cherub"] = {Rarity = "Ethereal", Color = Color3.fromRGB(255, 75, 120)},
    ["Blackhole"] = {Rarity = "Ethereal", Color = Color3.fromRGB(180, 50, 255)},
    ["Void"] = {Rarity = "Ethereal", Color = Color3.fromRGB(150, 40, 240)},
    ["Phoenix"] = {Rarity = "Divine", Color = Color3.fromRGB(255, 215, 0)},
    ["Angelic"] = {Rarity = "Divine", Color = Color3.fromRGB(255, 230, 100)},
    ["Galaxy"] = {Rarity = "Mythic", Color = Color3.fromRGB(170, 70, 255)},
    ["Shockwave"] = {Rarity = "Mythic", Color = Color3.fromRGB(130, 90, 255)},
    ["Golden"] = {Rarity = "Legendary", Color = Color3.fromRGB(255, 170, 0)},
    ["Crystal"] = {Rarity = "Legendary", Color = Color3.fromRGB(0, 210, 255)},
    ["Magma"] = {Rarity = "Epic", Color = Color3.fromRGB(255, 100, 30)}
}

local function getEggInfo(name)
    local lower = string.lower(name)
    for key, data in pairs(EGG_RARITIES) do
        if string.find(lower, string.lower(key)) then
            return data.Rarity, data.Color
        end
    end
    if string.find(lower, "ethereal") or string.find(lower, "eternal") then return "Ethereal", Color3.fromRGB(255, 65, 65) end
    if string.find(lower, "divine") then return "Divine", Color3.fromRGB(255, 215, 0) end
    if string.find(lower, "mythic") then return "Mythic", Color3.fromRGB(170, 70, 255) end
    if string.find(lower, "legendary") then return "Legendary", Color3.fromRGB(255, 170, 0) end
    return "Normal", Color3.fromRGB(220, 220, 220)
end

local function getEggWeight(eggObj)
    for _, desc in ipairs(eggObj:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" then
            local match = string.match(desc.Text, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
            if match then return match end
        end
    end
    for _, attr in ipairs({"Weight", "Kg", "KG", "Mass", "Size"}) do
        local val = eggObj:GetAttribute(attr)
        if val then return tostring(val) .. " KG" end
    end
    local size = eggObj:IsA("Model") and eggObj:GetExtentsSize() or (eggObj:IsA("BasePart") and eggObj.Size or Vector3.new(2, 2, 2))
    return math.floor((size.X * size.Y * size.Z) * 6.5) .. " KG"
end

-- =======================================================
-- LOCATION & STRICT WILD SPAWN SCANNER
-- =======================================================

local function getMyRanchPosition()
    local success, pos = pcall(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("TextLabel") and string.find(string.lower(v.Text), "your ranch") then
                local part = v:FindFirstAncestorWhichIsA("BasePart")
                if part then return part.Position end
            end
        end
        for _, v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("Folder")) and string.find(string.lower(v.Name), string.lower(player.Name)) then
                local part = v:FindFirstChildWhichIsA("BasePart", true)
                if part then return part.Position end
            end
        end
    end)

    if success and pos then return pos end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

local function isInsideMyRanch(eggPos)
    local home = getMyRanchPosition()
    return (eggPos - home).Magnitude <= 55
end

local function stabilize()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local hum = character:FindFirstChildWhichIsA("Humanoid")
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

-- Scan ONLY wild/spawned unowned eggs (strictly excludes your ranch & eggbase)
local function scanSpawnedEggsOnly()
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        local lower = string.lower(obj.Name)

        if (obj:IsA("Model") or obj:IsA("BasePart")) and string.find(lower, "egg") then
            -- Filter out base parts, shop stands, hatch areas, and EggBase
            if not string.find(lower, "stand") 
               and not string.find(lower, "hatch") 
               and not string.find(lower, "shop") 
               and not string.find(lower, "ui")
               and not string.find(lower, "eggbase")
               and not string.find(lower, "base")
            then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part and not isInsideMyRanch(part.Position) then
                    table.insert(results, {
                        Object = obj,
                        Part = part,
                        Name = obj.Name,
                        Weight = getEggWeight(obj)
                    })
                end
            end
        end
    end
    return results
end


local EGG_RARITIES = {
    ["Solaris"] = {Rarity = "Ethereal", Color = Color3.fromRGB(255, 65, 65)},
    ["Cherub"] = {Rarity = "Ethereal", Color = Color3.fromRGB(255, 75, 120)},
    ["Blackhole"] = {Rarity = "Ethereal", Color = Color3.fromRGB(180, 50, 255)},
    ["Void"] = {Rarity = "Ethereal", Color = Color3.fromRGB(150, 40, 240)},
    ["Phoenix"] = {Rarity = "Divine", Color = Color3.fromRGB(255, 215, 0)},
    ["Angelic"] = {Rarity = "Divine", Color = Color3.fromRGB(255, 230, 100)},
    ["Galaxy"] = {Rarity = "Mythic", Color = Color3.fromRGB(170, 70, 255)},
    ["Shockwave"] = {Rarity = "Mythic", Color = Color3.fromRGB(130, 90, 255)},
    ["Golden"] = {Rarity = "Legendary", Color = Color3.fromRGB(255, 170, 0)},
    ["Crystal"] = {Rarity = "Legendary", Color = Color3.fromRGB(0, 210, 255)},
    ["Magma"] = {Rarity = "Epic", Color = Color3.fromRGB(255, 100, 30)}
}

local function getEggInfo(name)
    local lower = string.lower(name)
    for key, data in pairs(EGG_RARITIES) do
        if string.find(lower, string.lower(key)) then
            return data.Rarity, data.Color
        end
    end
    if string.find(lower, "ethereal") or string.find(lower, "eternal") then return "Ethereal", Color3.fromRGB(255, 65, 65) end
    if string.find(lower, "divine") then return "Divine", Color3.fromRGB(255, 215, 0) end
    if string.find(lower, "mythic") then return "Mythic", Color3.fromRGB(170, 70, 255) end
    if string.find(lower, "legendary") then return "Legendary", Color3.fromRGB(255, 170, 0) end
    return "Normal", Color3.fromRGB(200, 200, 200)
end


-- Stabilize Character (Stops Void Flinging)
local function stabilize()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local hum = character:FindFirstChildWhichIsA("Humanoid")
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

-- Find Home Base Position
local cachedHome = nil
local function getHomePos()
    if cachedHome then return cachedHome end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("TextLabel") and string.find(string.lower(v.Text), "your ranch") then
            local p = v:FindFirstAncestorWhichIsA("BasePart") or v.Adornee
            if p then
                cachedHome = p.Position
                return cachedHome
            end
        end
    end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

-- =======================================================
-- CRASH-PROOF LIGHTWEIGHT SCANNER
-- =======================================================
local function scanRares()
    local list = {}
    local home = getHomePos()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    -- Scan only top-level models in workspace (Fast & Zero Lag)
    for _, obj in ipairs(workspace:GetChildren()) do
        local objName = string.lower(obj.Name)
        local match = nil

        for key, data in pairs(RARE_EGGS) do
            if string.find(objName, key) then
                match = data
                break
            end
        end

        -- Check prompt if model name is generic
        if not match and (string.find(objName, "egg") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)) then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                local text = string.lower((prompt.ObjectText or "") .. " " .. (prompt.ActionText or ""))
                for key, data in pairs(RARE_EGGS) do
                    if string.find(text, key) then
                        match = data
                        break
                    end
                end
            end
        end

        if match then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part and (part.Position - home).Magnitude > 50 then
                local dist = root and math.floor((root.Position - part.Position).Magnitude * 0.28) or 0
                table.insert(list, {
                    Object = obj,
                    Part = part,
                    Name = match.Name,
                    Tier = match.Tier,
                    Color = match.Color,
                    Rank = match.Rank,
                    Distance = dist
                })
            end
        end
    end

    table.sort(list, function(a, b) return a.Rank > b.Rank end)
    return list
end


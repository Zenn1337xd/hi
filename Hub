        sliderTitle.Text = "Speed Boost: " .. currentSpeedValue .. " (0 - 1000)"
        if speedEnabled then updateSpeed() end
    end)
end

local function makeToggle(parent, name, defaultState, callback)
    local state = defaultState
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.96, 0, 0, 34)
    btn.BackgroundColor3 = state and Color3.fromRGB(46, 170, 85) or Color3.fromRGB(34, 36, 48)
    btn.Text = name .. ": " .. (state and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(46, 170, 85) or Color3.fromRGB(34, 36, 48)
        btn.Text = name .. ": " .. (state and "ON" or "OFF")
        callback(state, btn)
    end)
    return btn
end


-- LOCATION & SCANNING (CRASH-PROOF)
-- =======================================================

local function getMyRanchPosition()
    local success, pos = pcall(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("TextLabel") and string.find(string.lower(v.Text), "your ranch") then
                local part = v:FindFirstAncestorWhichIsA("BasePart")
                if part then return part.Position end
            end
        end
        for _, v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("Folder")) and string.find(string.lower(v.Name), string.lower(player.Name)) then
                local part = v:FindFirstChildWhichIsA("BasePart", true)
                if part then return part.Position end
            end
        end
    end)

    if success and pos then return pos end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

local function isInsideMyRanch(eggPos)
    local home = getMyRanchPosition()
    return (eggPos - home).Magnitude <= 50
end

local function stabilize()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local hum = character:FindFirstChildWhichIsA("Humanoid")
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

-- Scan eggs across all workspace models and prompts
local function scanEggs(onlyUnowned)
    local results = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        local isEgg = false
        local lower = string.lower(obj.Name)

        if (obj:IsA("Model") or obj:IsA("BasePart")) and string.find(lower, "egg") then
            if not string.find(lower, "stand") and not string.find(lower, "hatch") and not string.find(lower, "shop") and not string.find(lower, "ui") then
                isEgg = true
            end
        end

        if isEgg then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local unownedCheck = not isInsideMyRanch(part.Position)
                if (not onlyUnowned) or unownedCheck then
                    table.insert(results, {
                        Object = obj,
                        Part = part,
                        Name = obj.Name,
                        Weight = getEggWeight(obj)
                    })
                end
            end
        end
    end
    return results
end

-- =======================================================
-- 3D VIEWPORT GENERATOR
-- =======================================================

local function render3D(parentFrame, eggObj, part)
    pcall(function()
        local vp = Instance.new("ViewportFrame")
        vp.Size = UDim2.new(0, 48, 0, 48)
        vp.Position = UDim2.new(0, 5, 0.5, -24)
        vp.BackgroundTransparency = 1
        vp.LightColor = Color3.fromRGB(255, 255, 255)
        vp.Ambient = Color3.fromRGB(220, 220, 220)
        vp.Parent = parentFrame

        eggObj.Archivable = true
        part.Archivable = true

        local clone = eggObj:Clone()
        if not clone then
            clone = Instance.new("Model")
            part:Clone().Parent = clone
        end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("BillboardGui") or d:IsA("ProximityPrompt") then
                d:Destroy()
            end
        end

        clone.Parent = vp
        local cf, size
        if clone:IsA("Model") then
            cf, size = clone:GetBoundingBox()
        else
            cf = clone.CFrame
            size = clone.Size
        end

        local cam = Instance.new("Camera")
        cam.Parent = vp
        vp.CurrentCamera = cam
        local maxDim = math.max(size.X, size.Y, size.Z)
        local dist = maxDim > 1 and maxDim * 1.8 or 3.5
        cam.CFrame = CFrame.new(cf.Position + Vector3.new(0, size.Y * 0.2, dist), cf.Position)
    end)
end


local BLACKLIST = {
    "wanna see", "world", "shop", "track", "gears", "sell", "food", 
    "index", "rebirth", "eggo", "hatch", "stand", "prompt", "base"
}

local function isIgnored(str)
    local lower = string.lower(str)
    for _, word in ipairs(BLACKLIST) do
        if string.find(lower, word) then return true end
    end
    return false
end

-- =======================================================
-- STABILIZE & BASE POSITION
-- =======================================================
local cachedRanchPos = nil

local function getMyRanchPosition()
    if cachedRanchPos then return cachedRanchPos end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") and string.find(string.lower(obj.Text), "your ranch") then
            local p = obj:FindFirstAncestorWhichIsA("BasePart") or obj.Adornee
            if p then
                cachedRanchPos = p.Position
                return cachedRanchPos
            end
        end
    end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

local function isInsideMyRanch(pos)
    return (pos - getMyRanchPosition()).Magnitude <= 50
end

local function stabilize()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local hum = character:FindFirstChildWhichIsA("Humanoid")
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

-- =======================================================
-- LIGHTWEIGHT ZERO-LAG SCANNER
-- =======================================================
local function checkObjectForRare(obj)
    if isIgnored(obj.Name) then return nil end

    local matched = nil
    local kgText = nil

    -- Check direct name
    local objLower = string.lower(obj.Name)
    for key, data in pairs(RARE_DATABASE) do
        if string.find(objLower, key) then
            matched = data
            break
        end
    end

    -- Check direct children only (avoids heavy GetDescendants freezes)
    if not matched then
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("ProximityPrompt") then
                local pText = string.lower((child.ObjectText or "") .. " " .. (child.ActionText or ""))
                for key, data in pairs(RARE_DATABASE) do
                    if string.find(pText, key) then
                        matched = data
                        break
                    end
                end
                local kg = string.match(pText, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
                if kg then kgText = kg end
            elseif child:IsA("TextLabel") then
                local tLower = string.lower(child.Text)
                for key, data in pairs(RARE_DATABASE) do
                    if string.find(tLower, key) then
                        matched = data
                        break
                    end
                end
                local kg = string.match(child.Text, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
                if kg then kgText = kg end
            end
            if matched then break end
        end
    end

    if not matched then return nil end

    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
    if not part or isInsideMyRanch(part.Position) then return nil end

    if not kgText then
        local size = obj:IsA("Model") and obj:GetExtentsSize() or part.Size
        local est = math.floor(size.X * size.Y * size.Z * 8.5)
        if matched.Rank >= 3 and est < 1000 then est = est * 1200 end
        kgText = tostring(est > 0 and est or 25) .. " KG"
    end

    return {
        Object = obj,
        Part = part,
        Name = matched.Name,
        Tier = matched.Tier,
        Color = matched.Color,
        Rank = matched.Rank,
        Weight = kgText
    }
end

-- Linear, Throttled Workspace Scan
local function scanAllRares()
    local results = {}
    local seenParts = {}
    local root = character and character:FindFirstChild("HumanoidRootPart")

    -- Check direct models and subfolders only
    for _, item in ipairs(workspace:GetChildren()) do
        if not isIgnored(item.Name) then
            local data = checkObjectForRare(item)
            if data and not seenParts[data.Part] then
                seenParts[data.Part] = true
                data.Distance = root and math.floor((root.Position - data.Part.Position).Magnitude * 0.28) or 0
                table.insert(results, data)
            end

            -- One level deep for performance
            if item:IsA("Folder") or item:IsA("Model") then
                for _, sub in ipairs(item:GetChildren()) do
                    local subData = checkObjectForRare(sub)
                    if subData and not seenParts[subData.Part] then
                        seenParts[subData.Part] = true
                        subData.Distance = root and math.floor((root.Position - subData.Part.Position).Magnitude * 0.28) or 0
                        table.insert(results, subData)
                    end
                end
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Rank ~= b.Rank then
            return a.Rank > b.Rank
        else
            return a.Distance < b.Distance
        end
    end)

    return results
end


-- =======================================================
-- LOCATION & RANCH FILTER
-- =======================================================

local function getMyRanchPosition()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BillboardGui") or v:IsA("TextLabel") then
            if string.find(string.lower(tostring(v.Text or "")), "your ranch") then
                local part = v:FindFirstAncestorWhichIsA("BasePart") or v.Adornee
                if part then return part.Position end
            end
        end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if string.find(string.lower(v.Name), string.lower(player.Name)) and string.find(string.lower(v.Name), "ranch") then
            local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart")
            if part then return part.Position end
        end
    end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

-- Checks if egg is already secured inside your ranch (< 45 studs)
local function isInsideMyRanch(eggPosition)
    local myRanch = getMyRanchPosition()
    return (eggPosition - myRanch).Magnitude <= 45
end

-- Stops velocity flinging
local function stabilizeCharacter()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- Scans only UNOWNED eggs that are valid for stealing
local function scanUnownedEggs()
    local unowned = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and string.find(string.lower(obj.Name), "egg") then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part and not string.find(string.lower(obj.Name), "stand") and not string.find(string.lower(obj.Name), "hatch") then
                if not isInsideMyRanch(part.Position) then
                    table.insert(unowned, {
                        Object = obj,
                        Part = part,
                        Name = obj.Name,
                        Weight = getEggWeight(obj)
                    })
                end
            end
        end
    end
    return unowned
end

-- =======================================================
-- UNOWNED ESP SYSTEM
-- =======================================================

local function clearESP()
    for _, tag in ipairs(espStorage) do
        if tag and tag.Parent then tag:Destroy() end
    end
    espStorage = {}
end

local function refreshESP()
    clearESP()
    if not espEnabled then return end

    local unownedEggs = scanUnownedEggs()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, eggData in ipairs(unownedEggs) do
        local targetPart = eggData.Part
        if targetPart and not targetPart:FindFirstChild("EggESP") then
            local rarity, rarityColor = getEggInfo(eggData.Name)

            local bill = Instance.new("BillboardGui")
            bill.Name = "EggESP"
            bill.Size = UDim2.new(0, 160, 0, 52)
            bill.AlwaysOnTop = true
            bill.Adornee = targetPart

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = rarityColor
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 11
            txt.Parent = bill
            bill.Parent = targetPart
            table.insert(espStorage, bill)

            task.spawn(function()
                while espEnabled and targetPart and targetPart.Parent do
                    -- If egg gets brought to our ranch, remove its ESP tag
                    if isInsideMyRanch(targetPart.Position) then
                        bill:Destroy()
                        break
                    end

                    if root then
                        local studs = math.floor((root.Position - targetPart.Position).Magnitude)
                        local meters = math.floor(studs * 0.28)
                        txt.Text = string.format("[STEALABLE]\n%s (%s)\n%dm | %s", eggData.Name, rarity, meters, eggData.Weight)
                    end
                    task.wait(0.5)
                end
                if bill then bill:Destroy() end
            end)
        end
    end
end

-- =======================================================
-- STEAL ROUTINE (TELEPORT + INSTANT RANCH RETURN)
-- =======================================================

local function runSteal(instant)
    if isStealing then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targets = scanUnownedEggs()
    if #targets == 0 then return end

    isStealing = true
    local homePos = getMyRanchPosition()

    for _, eggData in ipairs(targets) do
        if not (autoStealEnabled or instantStealEnabled) then break end
        local eggPart = eggData.Part

        if eggPart and eggPart.Parent and not isInsideMyRanch(eggPart.Position) then
            stabilizeCharacter()

            -- Teleport to Egg
            if instant then
                root.CFrame = eggPart.CFrame * CFrame.new(0, 3.5, 0)
            else
                local tween = TweenService:Create(root, TweenInfo.new(1, Enum.EasingStyle.Linear), {CFrame = eggPart.CFrame * CFrame.new(0, 3.5, 0)})
                tween:Play()
                tween.Completed:Wait()
            end
            task.wait(0.2)

            -- Grab prompt
            local prompt = eggData.Object:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                if fireproximityprompt then
                    fireproximityprompt(prompt, 0)
                else
                    prompt:InputHoldBegin()
                    task.wait(prompt.HoldDuration + 0.1)
                    prompt:InputHoldEnd()
                end
            end
            task.wait(0.3)

            -- Instant Return to Ranch
            stabilizeCharacter()
            root.CFrame = CFrame.new(homePos + Vector3.new(0, 5, 0))
            stabilizeCharacter()
            task.wait(0.8)
        end
    end

    stabilizeCharacter()
    isStealing = false
end

task.spawn(function()
    while true do
        if instantStealEnabled then
            runSteal(true)
        elseif autoStealEnabled then
            runSteal(false)
        end
        task.wait(0.6)
    end
end)

-- Heartbeat Loop for Speed
local function setSpeed(enabled)
    speedEnabled = enabled
    if speedConnection then speedConnection:Disconnect() speedConnection = nil end
    if enabled then
        speedConnection = RunService.Heartbeat:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                local hum = character:FindFirstChildWhichIsA("Humanoid")
                hum.WalkSpeed = 1000
                if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
                    hum.SeatPart.MaxSpeed = 1000
                    hum.SeatPart.ThrottleFloat = 1
                end
            end
        end)
    else
        if character and character:FindFirstChildWhichIsA("Humanoid") then
            character:FindFirstChildWhichIsA("Humanoid").WalkSpeed = 16
        end
    end
end

-- Jump Request Loop
local function setInfJump(enabled)
    infJumpEnabled = enabled
    if jumpConnection then jumpConnection:Disconnect() jumpConnection = nil end
    if enabled then
        jumpConnection = UserInputService.JumpRequest:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                character:FindFirstChildWhichIsA("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end


-- Helper Button Generator
local function makeButton(text, order, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.92, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(40, 42, 54)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamMedium
    btn.LayoutOrder = order
    btn.Parent = buttonContainer

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- Feature 1: WalkSpeed Boost
makeButton("Boost WalkSpeed (35)", 1, function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if hum then
        hum.WalkSpeed = 35
    end
end)

-- Feature 2: Super Jump
makeButton("Super Jump (100)", 2, function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if hum then
        hum.JumpPower = 100
    end
end)

-- Feature 3: Auto-Equip Pet Tool
makeButton("Equip Held Pet", 3, function()
    local char = player.Character or player.CharacterAdded:Wait()
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (string.find(string.lower(tool.Name), "pet") or string.find(string.lower(tool.Name), "ride")) then
                tool.Parent = char
                break
            end
        end
    end
end)

-- Feature 4: Reset Character Speeds
makeButton("Reset Speed & Jump", 4, function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if hum then
        hum.WalkSpeed = 16
        hum.JumpPower = 50
    end
end)


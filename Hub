-- ESP System
local function clearESP()
    for _, bill in ipairs(activeESP) do
        if bill and bill.Parent then bill:Destroy() end
    end
    activeESP = {}
end

local function refreshESP()
    clearESP()
    if not espEnabled then return end

    local targets = scanRealSpawnedEggs()

    for _, data in ipairs(targets) do
        local targetPart = data.Part
        if targetPart and not targetPart:FindFirstChild("KevanLagFreeESP") then
            local bill = Instance.new("BillboardGui")
            bill.Name = "KevanLagFreeESP"
            bill.Size = UDim2.new(0, 150, 0, 44)
            bill.AlwaysOnTop = true
            bill.Adornee = targetPart

            local box = Instance.new("Frame")
            box.Size = UDim2.new(1, 0, 1, 0)
            box.BackgroundColor3 = Color3.fromRGB(15, 17, 24)
            box.BackgroundTransparency = 0.25
            box.Parent = bill
            Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

            local stroke = Instance.new("UIStroke", box)
            stroke.Color = data.Color
            stroke.Thickness = 1.5

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, -6, 1, 0)
            txt.Position = UDim2.new(0, 3, 0, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = data.Color
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 10
            txt.Text = string.format("[%s]\n%s\n%s", data.Rarity, data.Name, data.Weight)
            txt.Parent = box

            bill.Parent = targetPart
            table.insert(activeESP, bill)
        end
    end
end

task.spawn(function()

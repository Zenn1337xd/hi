-- POPULATE EGG RADAR & TELEPORT TAB
-- =======================================================
local function refreshRadar()
    for _, child in ipairs(radarScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            child:Destroy()
        end
    end

    -- Refresh Action Button
    local refBtn = Instance.new("TextButton")
    refBtn.Size = UDim2.new(0.96, 0, 0, 30)
    refBtn.BackgroundColor3 = Color3.fromRGB(55, 60, 85)
    refBtn.Text = "🔄 Scan / Refresh Map Eggs"
    refBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    refBtn.Font = Enum.Font.GothamBold
    refBtn.TextSize = 12
    refBtn.Parent = radarScroll
    Instance.new("UICorner", refBtn).CornerRadius = UDim.new(0, 6)
    refBtn.MouseButton1Click:Connect(refreshRadar)

    local eggs = scanEggs()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if #eggs == 0 then
        local emptyLbl = Instance.new("TextLabel")
        emptyLbl.Size = UDim2.new(0.96, 0, 0, 40)
        emptyLbl.BackgroundTransparency = 1
        emptyLbl.Text = "No Eggs currently spotted in workspace."
        emptyLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
        emptyLbl.Font = Enum.Font.Gotham
        emptyLbl.TextSize = 11
        emptyLbl.Parent = radarScroll
        return
    end

    radarScroll.CanvasSize = UDim2.new(0, 0, 0, 40 + (#eggs * 46))

    for _, eggData in ipairs(eggs) do
        local rarity, rarityColor = getEggInfo(eggData.Name)
        local dist = root and math.floor((root.Position - eggData.Part.Position).Magnitude * 0.28) or 0

        local card = Instance.new("Frame")
        card.Size = UDim2.new(0.96, 0, 0, 40)
        card.BackgroundColor3 = Color3.fromRGB(28, 30, 40)
        card.Parent = radarScroll
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

        -- Egg Name & Rarity Label
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.68, 0, 1, 0)
        lbl.Position = UDim2.new(0, 8, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = eggData.Name .. " (" .. rarity .. ")\n" .. dist .. "m away"
        lbl.TextColor3 = rarityColor
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = card

        -- Direct Teleport Button
        local tpBtn = Instance.new("TextButton")
        tpBtn.Size = UDim2.new(0.26, 0, 0, 28)
        tpBtn.Position = UDim2.new(0.72, 0, 0.15, 0)
        tpBtn.BackgroundColor3 = Color3.fromRGB(70, 75, 110)
        tpBtn.Text = "TP"
        tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tpBtn.Font = Enum.Font.GothamBold
        tpBtn.TextSize = 12
        tpBtn.Parent = card
        Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 6)

        tpBtn.MouseButton1Click:Connect(function()
            if character and character:FindFirstChild("HumanoidRootPart") and eggData.Part and eggData.Part.Parent then
                stabilizeCharacter()
                character.HumanoidRootPart.CFrame = eggData.Part.CFrame * CFrame.new(0, 4, 0)
                stabilizeCharacter()
                notify("Teleported!", "Moved to " .. eggData.Name)
            end
        end)
    end
end


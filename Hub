    radarScroll.CanvasSize = UDim2.new(0, 0, 0, 40 + (#unowned * 46))

    for _, data in ipairs(unowned) do
        local rarity, rarityColor = getEggInfo(data.Name)
        local dist = root and math.floor((root.Position - data.Part.Position).Magnitude * 0.28) or 0


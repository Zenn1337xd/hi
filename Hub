local function getEggImage(eggObj, fallbackIcon)
    for _, desc in ipairs(eggObj:GetDescendants()) do
        if desc:IsA("Decal") and desc.Texture ~= "" then
            return desc.Texture
        elseif desc:IsA("MeshPart") and desc.TextureID ~= "" then
            return desc.TextureID
        elseif desc:IsA("SpecialMesh") and desc.TextureId ~= "" then
            return desc.TextureId
        end
    end
    return fallbackIcon
end

-- Deep Inspector: STRICTLY isolates Divine and Ethereal/Eternal Eggs
local function checkRareEgg(obj, part)
    local detectedData = nil
    local foundWeight = nil

    -- 1. Scan ProximityPrompts
    for _, prompt in ipairs(obj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local pText = string.lower((prompt.ObjectText or "") .. " " .. (prompt.ActionText or ""))
            for key, data in pairs(STRICT_RARES) do
                if string.find(pText, key) then
                    detectedData = data
                    break
                end
            end
            local kg = string.match(pText, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
            if kg then foundWeight = kg end
        end
    end

    -- 2. Scan Attributes
    if not detectedData then
        for k, v in pairs(obj:GetAttributes()) do
            local combined = string.lower(tostring(k) .. " " .. tostring(v))
            for key, data in pairs(STRICT_RARES) do
                if string.find(combined, key) then
                    detectedData = data
                    break
                end
            end
        end
    end

    -- 3. Scan TextLabels and Descendants
    if not detectedData then
        for _, desc in ipairs(obj:GetDescendants()) do
            local lower = string.lower(desc.Name)
            for key, data in pairs(STRICT_RARES) do
                if string.find(lower, key) then
                    detectedData = data
                    break
                end
            end
            if desc:IsA("TextLabel") and desc.Text ~= "" then
                local tLower = string.lower(desc.Text)
                for key, data in pairs(STRICT_RARES) do
                    if string.find(tLower, key) then
                        detectedData = data
                        break
                    end
                end
                local kg = string.match(desc.Text, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
                if kg then foundWeight = kg end
            end
        end
    end

    -- 4. Check Container Name
    if not detectedData then
        local objLower = string.lower(obj.Name .. " " .. (obj.Parent and obj.Parent.Name or ""))
        for key, data in pairs(STRICT_RARES) do
            if string.find(objLower, key) then
                detectedData = data
                break
            end
        end
    end

    -- STRICT RULE: If it's not Divine or Ethereal, DROP IT
    if not detectedData then
        return nil
    end

    local finalWeight = foundWeight
    if not finalWeight then
        local size = obj:IsA("Model") and obj:GetExtentsSize() or part.Size
        local est = math.floor((size.X * size.Y * size.Z) * 8.5)
        if est < 1000 then est = est * 1200 end
        finalWeight = tostring(est) .. " KG"
    end

    return {
        Name = detectedData.Name,
        Rarity = detectedData.Rarity,
        Color = detectedData.Color,
        Rank = detectedData.Rank,
        Weight = finalWeight,
        Image = getEggImage(obj, detectedData.Icon)
    }
end

-- =======================================================
-- LOCATION & BASE EXCLUSION
-- =======================================================
local function getMyRanchPosition()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") and string.find(string.lower(obj.Text), "your ranch") then
            local p = obj:FindFirstAncestorWhichIsA("BasePart") or obj.Adornee
            if p then return p.Position end
        end
    end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

local function isInsideMyRanch(pos)
    local myRanch = getMyRanchPosition()
    return (pos - myRanch).Magnitude <= 50
end

local function stabilize()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local hum = character:FindFirstChildWhichIsA("Humanoid")
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

local function scanStrictRares()
    local results = {}
    local scannedParts = {}
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, obj in ipairs(workspace:GetDescendants()) do
        local lower = string.lower(obj.Name)

        if not string.find(lower, "stand") and not string.find(lower, "hatch") and not string.find(lower, "shop") and not string.find(lower, "eggbase") then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part and not scannedParts[part] and not isInsideMyRanch(part.Position) then
                local rareInfo = checkRareEgg(obj, part)
                if rareInfo then
                    scannedParts[part] = true
                    local dist = root and math.floor((root.Position - part.Position).Magnitude * 0.28) or 0
                    table.insert(results, {
                        Object = obj,
                        Part = part,
                        Name = rareInfo.Name,
                        Rarity = rareInfo.Rarity,
                        Color = rareInfo.Color,
                        Rank = rareInfo.Rank,
                        Weight = rareInfo.Weight,
                        Image = rareInfo.Image,
                        Distance = dist
                    })
                end
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Rank ~= b.Rank then
            return a.Rank > b.Rank
        else
            return a.Distance < b.Distance
        end
    end)

    return results
end


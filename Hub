-- Accurate KG Parser
local function getAccurateKG(eggObj, part)
    for _, desc in ipairs(eggObj:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" then
            local match = string.match(desc.Text, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
            if match then return match end
        end
    end

    for _, attr in ipairs({"Weight", "Kg", "KG", "Mass", "Size"}) do
        local val = eggObj:GetAttribute(attr)
        if val and tonumber(val) and tonumber(val) > 0 then return tostring(val) .. " KG" end
    end

    local size = eggObj:IsA("Model") and eggObj:GetExtentsSize() or part.Size
    local est = math.floor((size.X * size.Y * size.Z) * 8.5)
    return (est > 0 and est or 25) .. " KG"
end

-- Deep Inspection Egg Parser (Resolves [Normal] and placeholders)
local function parseEggDetails(obj, part)
    local foundName = nil
    local foundRarity = nil
    local foundWeight = nil

    -- 1. Scan all TextLabels inside the Egg model and its overhead GUI
    for _, desc in ipairs(obj:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" then
            local rawText = desc.Text
            local lower = string.lower(rawText)

            -- Check for rarity tags
            for rName, _ in pairs(RARITY_TIERS) do
                if string.find(lower, string.lower(rName)) then
                    foundRarity = rName
                end
            end
            if string.find(lower, "eternal") then foundRarity = "Ethereal" end
            if string.find(lower, "volcan") then 
                foundRarity = "Divine"
                foundName = foundName or "Volcano Egg"
            end

            -- Check for true Egg Name
            if string.find(lower, "egg") and not string.find(lower, "skip") and not string.find(lower, "base") and not string.find(lower, "hatch") then
                local clean = string.gsub(rawText, "%[.-%]", "") -- Strip brackets like [Normal]
                clean = string.gsub(clean, "\n.*", "")           -- Strip subtitle timers
                clean = string.match(clean, "^%s*(.-)%s*$")       -- Trim spaces
                if clean ~= "" and string.len(clean) > 2 and string.lower(clean) ~= "normal" then
                    foundName = clean
                end
            end

            -- Check for KG text
            local kgMatch = string.match(rawText, "(%d+%.?%d*%s*[kKmMbBtT]*%s*[kK][gG])")
            if kgMatch then
                foundWeight = kgMatch
            end
        end
    end

    -- 2. Check Database Keywords on the object or parent name
    local objLower = string.lower(obj.Name)
    for key, tier in pairs(EGG_DATABASE) do
        if string.find(objLower, string.lower(key)) then
            foundName = foundName or (key .. " Egg")
            foundRarity = foundRarity or tier
            break
        end
    end

    -- 3. Check Custom Attributes
    for _, attr in ipairs({"Rarity", "Tier"}) do
        local val = obj:GetAttribute(attr)
        if val and type(val) == "string" then
            for rName, _ in pairs(RARITY_TIERS) do
                if string.find(string.lower(val), string.lower(rName)) then
                    foundRarity = rName
                end
            end
        end
    end

    local finalName = foundName or obj.Name
    if string.lower(finalName) == "eggspawn" or string.lower(finalName) == "normal" or string.lower(finalName) == "[normal]" or string.lower(finalName) == "spawn" then
        finalName = "Wild Egg"
    end

    local finalRarity = foundRarity or "Normal"
    local tierData = RARITY_TIERS[finalRarity] or RARITY_TIERS["Normal"]
    local finalWeight = foundWeight or getAccurateKG(obj, part)

    return finalName, finalRarity, tierData.Color, tierData.Rank, finalWeight
end

-- =======================================================
-- LOCATION & BASE PROTECTION
-- =======================================================
local allRanchLocations = {}

local function updateRanchLocations()
    allRanchLocations = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "eggbase") or string.find(string.lower(obj.Name), "nest")) then
            table.insert(allRanchLocations, obj.Position)
        elseif obj:IsA("TextLabel") and string.find(string.lower(obj.Text), "ranch") then
            local p = obj:FindFirstAncestorWhichIsA("BasePart") or obj.Adornee
            if p then table.insert(allRanchLocations, p.Position) end
        end
    end
end

local function isInsideAnyRanch(pos)
    for _, ranchPos in ipairs(allRanchLocations) do
        if (pos - ranchPos).Magnitude <= 55 then
            return true
        end
    end
    return false
end

local function getMyRanchPosition()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") and string.find(string.lower(obj.Text), "your ranch") then
            local p = obj:FindFirstAncestorWhichIsA("BasePart") or obj.Adornee
            if p then return p.Position end
        end
    end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

local function stabilize()
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local hum = character:FindFirstChildWhichIsA("Humanoid")
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

-- Strictly scans wild spawned eggs and ranks them by rarity
local function scanRealSpawnedEggs()
    updateRanchLocations()
    local results = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        local lower = string.lower(obj.Name)

        if (obj:IsA("Model") or obj:IsA("BasePart")) and string.find(lower, "egg") then
            if not string.find(lower, "stand") 
               and not string.find(lower, "hatch") 
               and not string.find(lower, "shop") 
               and not string.find(lower, "ui")
               and not string.find(lower, "eggbase")
            then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part and not isInsideAnyRanch(part.Position) then
                    local name, rarity, color, rank, kg = parseEggDetails(obj, part)
                    
                    if not (string.lower(name) == "eggspawn" and kg == "0 KG") then
                        table.insert(results, {
                            Object = obj,
                            Part = part,
                            Name = name,
                            Rarity = rarity,
                            Color = color,
                            Rank = rank,
                            Weight = kg
                        })
                    end
                end
            end
        end
    end

    -- PUSH RARITY TO TOP: Ethereal / Divine / Mythic sorted first
    table.sort(results, function(a, b)
        return a.Rank > b.Rank
    end)

    return results
end

